# Optional: only required by live LLM planning / repair adapters
OPENAI_API_KEY=
OPENAI_MODEL=

# Local Plan/Run API: also requires allow_network=true on each live request.
ENRICHMENT_ALLOW_NETWORK=0

# Optional: offers the driving distance by road (docs/30-road-distance-and-ratio.md).
# A free key from https://account.heigit.org. Without it nothing changes.
OPENROUTESERVICE_API_KEY=

# Optional: the universal search (docs/22-m5-plan-run-api.md, "The universal search").
# Offered when the planner cannot build a plan: a model with web search looks up the
# values for each row. Off unless 1, because every row costs model tokens and a search
# fee on the key above. It also needs the network gate (--allow-network or the line above).
ENRICHMENT_ALLOW_WEB_LOOKUP=0
# ENRICHMENT_WEB_LOOKUP_MODEL=gpt-6-luna

# Optional: where the usage summary (/#usage) is kept across restarts (docs/27-hosted-demo.md).
# The local launcher keeps it in your state folder by default; a hosted app keeps nothing
# unless this names a file. `off` switches it off. Numbers and fixed words only.
# ENRICHMENT_USAGE_FILE=

# Optional LangSmith tracing (disabled by default)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-data-enrichment-studio
# EU-hosted LangSmith organization; use https://api.smith.langchain.com for US
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Hosted demo only (docs/27-hosted-demo.md): shared code every visitor must enter.
# ENRICHMENT_ACCESS_CODE=

# Optional, mail probe only (docs/32-mail-extraction-probe.md, "Reading from Gmail"): the OAuth
# client JSON (type Desktop app) of your own Google Cloud project. Keep the file outside the
# repository or in the ignored folder credentials/. The same as --gmail-client.
# Needs: uv sync --extra mail. Use forward slashes; a path with single backslashes stops uv
# from reading this file from that line on.
# ENRICHMENT_GMAIL_CLIENT_FILE=credentials/client_secret_....json
