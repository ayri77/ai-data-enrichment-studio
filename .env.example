# Optional: only required by live LLM planning / repair adapters
OPENAI_API_KEY=
OPENAI_MODEL=

# Local Plan/Run API: also requires allow_network=true on each live request.
ENRICHMENT_ALLOW_NETWORK=0

# Optional LangSmith tracing (disabled by default)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-data-enrichment-studio
# EU-hosted LangSmith organization; use https://api.smith.langchain.com for US
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
