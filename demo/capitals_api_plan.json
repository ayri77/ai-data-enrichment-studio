{
  "version": "1.0",
  "steps": [
    {
      "id": "from_city",
      "capability": "geocode",
      "inputs": {
        "city": {"kind": "column", "name": "Capital_From"},
        "country": {"kind": "column", "name": "Country_From"}
      },
      "parameters": {}
    },
    {
      "id": "to_city",
      "capability": "geocode",
      "inputs": {
        "city": {"kind": "column", "name": "Capital_To"},
        "country": {"kind": "column", "name": "Country_To"}
      },
      "parameters": {}
    },
    {
      "id": "distance",
      "capability": "geodesic_distance",
      "inputs": {
        "point_a": {"kind": "step_output", "step_id": "from_city"},
        "point_b": {"kind": "step_output", "step_id": "to_city"}
      },
      "parameters": {"unit": "km"}
    }
  ],
  "outputs": [
    {"step_id": "distance", "value_field": "value", "target_column": "distance", "expected_unit": "km"}
  ],
  "assumptions": ["Resolve each literal city in its supplied country, including Istanbul."]
}
